  "private": true,
  "homepage": "https://claudemircasa.github.io/react-chords",
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tombatossals/react-chords": "file:./react-chords",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "prestart": "npm run build:library && node scripts/sync-chords-catalog.js",
